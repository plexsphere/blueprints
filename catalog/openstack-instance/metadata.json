{
  "slug": "openstack-instance",
  "displayName": "OpenStack Instance",
  "description": "A single OpenStack Nova server that boots the plexsphere broker's cloud-init document and registers as a plexsphere node.",
  "version": "v1alpha2",
  "providerKinds": ["openstack"],
  "injectionStrategy": "cloud-init-user-data",
  "meshRole": "node",
  "parameterSchema": {
    "parameters": [
      {"name": "imageName", "type": "string", "required": true},
      {"name": "flavorName", "type": "string", "required": true},
      {"name": "networkName", "type": "string", "required": true},
      {"name": "availabilityZone", "type": "string", "required": false}
    ]
  }
}
